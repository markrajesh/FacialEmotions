# Facial Emotion Detection — Environment Variables
# Copy this file to .env and fill in values as needed.
# All values shown are the application defaults.

# Path to the ONNX emotion model file inside models/emotion/
EMOTION_MODEL_FILE=emotion_model.onnx

# Maximum number of faces to process per frame (1-10)
MAX_FACES=5

# MediaPipe face detection confidence thresholds
FACE_DETECTION_CONFIDENCE=0.5
FACE_TRACKING_CONFIDENCE=0.5

# Performance budgets
IMAGE_ANALYSIS_TIMEOUT_S=2.0
WEBCAM_FRAME_BUDGET_MS=250.0
WEBCAM_TARGET_FPS=10.0

# Video sampling rate (frames per second to sample from uploaded video)
VIDEO_SAMPLE_FPS=2.0
VIDEO_MAX_DURATION_S=600.0

# ---------------------------------------------------------------------------
# Image size limits (feature 002 — expand image size limits)
# ---------------------------------------------------------------------------

# Minimum accepted side length (px). Images with a shorter side below this are
# rejected. Must be ≥ 224 — the ONNX emotion model requires at least 224×224
# input; going below will produce empty crops and no detections.
IMAGE_MIN_SIDE=224

# Longest-side ceiling (px) above which the image is auto-downscaled before
# analysis. The downscaled frame is used for face detection and emotion
# inference; bounding-box coordinates are remapped back to the original
# resolution before returning results. Must be ≤ IMAGE_REJECTION_CEILING.
IMAGE_PROCESSING_CEILING=4096

# Longest-side hard limit (px). Images whose longest side exceeds this value
# are rejected outright (MediaIOError) — they are never downscaled.
# Must be ≥ IMAGE_PROCESSING_CEILING.
IMAGE_REJECTION_CEILING=8192
