# Facial Emotion Detection — Environment Variables
# Copy this file to .env and fill in values as needed.
# All values shown are the application defaults.

# Path to the ONNX emotion model file inside models/emotion/
EMOTION_MODEL_FILE=emotion_model.onnx

# Maximum number of faces to process per frame (1-10)
MAX_FACES=5

# MediaPipe face detection confidence thresholds
FACE_DETECTION_CONFIDENCE=0.5
FACE_TRACKING_CONFIDENCE=0.5

# Performance budgets
IMAGE_ANALYSIS_TIMEOUT_S=2.0
WEBCAM_FRAME_BUDGET_MS=250.0
WEBCAM_TARGET_FPS=10.0

# Video sampling rate (frames per second to sample from uploaded video)
VIDEO_SAMPLE_FPS=2.0
VIDEO_MAX_DURATION_S=600.0
